# infra/monitoring · variables del stack de observabilidad.
# Copia a .env y ajusta si necesitas cambiar puertos o credenciales.

# --- Puertos / retención ----------------------------------------------------
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d

# --- Grafana admin ----------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
