+# infra/monitoring · environment for the Tailscale-connected stack (Server C).
+# Copy to .env and fill in before `docker compose -f docker-compose.tailscale.yml up -d`.
+
+# --- Tailscale (required for docker-compose.tailscale.yml) ------------------
+# Auth key from the Tailscale admin console: Settings -> Keys -> Generate.
+# Reusable or ephemeral both work; a tag is optional (see TS_EXTRA_ARGS).
+TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
+
+# Tailnet node name for Server C (reachable as http://<TS_HOSTNAME>:3000).
+TS_HOSTNAME=monitoring
+
+# Extra flags for `tailscale up`, e.g. advertise an ACL tag:
+# TS_EXTRA_ARGS=--advertise-tags=tag:monitoring
+
+# --- Ports / retention ------------------------------------------------------
+GRAFANA_PORT=3000
+PROMETHEUS_PORT=9090
+PROMETHEUS_RETENTION=15d
+
+# --- Grafana admin ----------------------------------------------------------
+GRAFANA_ADMIN_USER=admin
+GRAFANA_ADMIN_PASSWORD=admin
