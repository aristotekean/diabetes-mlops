# Copy to .env to override the Docker Compose defaults shown here.

# Registry namespace of the project images.
DOCKERHUB_USER=aristotekean

# Inference API (S4) and frontend (S7).
API_PORT=8000
API_CPUS=1
API_MEMORY=1g
FRONTEND_PORT=8501

# MLflow UI: extra allowed host names, comma separated (e.g. a VM IP:port).
MLFLOW_ALLOWED_HOSTS=

# Airflow (S6).
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_JWT_SECRET=change-me-jwt-secret

# Locust (`loadtest` profile).
LOCUST_HOST=http://api-inference:8000
LOCUST_WORKERS=2
LOCUST_PORT=8089
LOCUST_ARGS=
