# Diabetes MLOps · configuration of the whole stack.
#
# Single source of truth for docker compose and Kubernetes. Copy it to .env
# (git-ignored) and set the real values there:
#   cp .env.example .env
#
# - docker compose reads .env from the repository root (root docker-compose.yml
#   and the files it includes). Standalone runs of a sub-stack pass it
#   explicitly: --env-file ../../.env (see each compose file).
# - Kubernetes: `bash infra/k8s/scripts/render-env.sh` turns it into the
#   ConfigMaps, Secrets and image tags of infra/k8s/generated (git-ignored);
#   run it before every `kubectl apply -k infra/k8s`.
# - scripts/publish_images.sh reads DOCKERHUB_USER and IMAGE_TAG from here.
#
# Values with spaces or shell characters (&, *, ?) go in single quotes: the
# file is read by docker compose and sourced by bash. Database passwords are
# embedded in connection URLs, so avoid @ : / ? # % in them. Credentials of a
# database are applied when its volume is first created; changing them later
# requires recreating that volume (or changing the password inside Postgres).

# --- Project images (API, frontend, Airflow) ----------------------------------
# scripts/publish_images.sh pushes them for linux/amd64 and linux/arm64, so the
# same tag runs on an Apple Silicon Mac and on a Linux server, VM or node.
DOCKERHUB_USER=aristotekean
IMAGE_TAG=0.1.1

# --- S1 · PostgreSQL backend store of MLflow -----------------------------------
MLFLOW_DB_NAME=mlflow
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=mlflow

# --- S3 · MinIO (MLflow artifact store) ----------------------------------------
# The same account is handed to S3 clients as AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MLFLOW_ARTIFACTS_BUCKET=mlflow
# `public` lets Prometheus scrape /minio/v2/metrics/* without a bearer token
# (only usage/traffic counters, never objects); `jwt` requires one.
MINIO_PROMETHEUS_AUTH_TYPE=public

# --- S2 · MLflow tracking server and registry ----------------------------------
# Service names shared by compose and Kubernetes.
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
MLFLOW_EXPERIMENT_NAME=diabetes-readmission
# Extra allowed Host headers and CORS origins of the UI, comma separated. Needed
# to open the UI from another machine, e.g. 192.168.1.50:* and
# http://192.168.1.50:5001. Empty keeps localhost, the Service names and
# *.orb.local only.
MLFLOW_ALLOWED_HOSTS=
MLFLOW_CORS_ALLOWED_ORIGINS=

# --- Registered model (written by Airflow, served by the API) ------------------
MODEL_NAME=diabetes
MODEL_ALIAS=production
# API poll of the alias in seconds; 0 disables it.
MODEL_REFRESH_SECONDS=60

# --- S5 · PostgreSQL training database (raw, clean and inference schemas) ------
# Host and port as seen from inside the stack (not the published host port).
TRAIN_DB_HOST=postgres-train
TRAIN_DB_PORT=5432
TRAIN_DB_NAME=diabetes
TRAIN_DB_USER=app
TRAIN_DB_PASSWORD=app

# --- S6 · Airflow ---------------------------------------------------------------
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
# Admin user of the UI, created on the first start.
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
# Signs the tokens between the api-server and the task runners.
AIRFLOW_JWT_SECRET=change-me-jwt-secret
# Empty: connections and variables are stored unencrypted. Generate one with
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Linux + compose: set it to the output of `id -u` so Airflow can write the
# bind-mounted logs/ and data/ folders. macOS: leave 50000.
AIRFLOW_UID=50000
# Each run loads the next RAW batch, so a short interval replays the
# incremental arrival of the 7 batches in about an hour.
DIABETES_TRAINING_SCHEDULE='*/10 * * * *'
DIABETES_DATASET_PATH=/opt/airflow/data/Diabetes/Diabetes.csv
DIABETES_SOURCE_URI='https://docs.google.com/uc?export=download&confirm=t&id=1k5-1caezQ3zWJbKaiMULTGq-3sz6uThC'

# --- S7 · Frontend --------------------------------------------------------------
API_URL=http://api-inference:8000

# --- docker compose: host ports and API limits ---------------------------------
API_PORT=8000
API_CPUS=1
API_MEMORY=1g
FRONTEND_PORT=8501
# Host port 5001: macOS AirPlay Receiver squats 5000.
MLFLOW_PORT=5001
MLFLOW_DB_PORT=5431
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
AIRFLOW_PORT=8080
# Change it if the host already runs PostgreSQL.
POSTGRES_TRAIN_PORT=5432

# --- S8 · Prometheus and S9 · Grafana (`monitoring` profile) --------------------
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Locust (`loadtest` profile) ------------------------------------------------
# Kubernetes on OrbStack: http://api.k8s.orb.local
LOCUST_HOST=http://api-inference:8000
LOCUST_WORKERS=2
LOCUST_PORT=8089
# Extra locust arguments, e.g. --headless -u 50 -r 5 -t 3m --csv /mnt/results/u50
LOCUST_ARGS=
# 1 replaces users/spawn rate with a staircase to find the degradation point.
LOCUST_STEP_LOAD=0
LOCUST_STEP_USERS=10
LOCUST_STEP_SECONDS=60
LOCUST_STEP_MAX_USERS=100
