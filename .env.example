# Copy to .env to override the Docker Compose defaults shown here.

# Registry namespace and tag of the project images (API, frontend, Airflow).
# scripts/publish_images.sh pushes them for linux/amd64 and linux/arm64, so
# the same tag runs on an Apple Silicon Mac and on a Linux server or VM.
DOCKERHUB_USER=aristotekean
IMAGE_TAG=0.1.1

# Inference API (S4) and frontend (S7).
API_PORT=8000
API_CPUS=1
API_MEMORY=1g
FRONTEND_PORT=8501

# MLflow (S2), its metadata database (S1) and MinIO (S3): host ports.
MLFLOW_PORT=5001
MLFLOW_DB_PORT=5431
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# MLflow UI: extra allowed host names, comma separated. Needed to open the UI
# from another machine, e.g. 192.168.1.50:* for a Linux server or VM.
MLFLOW_ALLOWED_HOSTS=

# Airflow (S6) and the training database (S5).
# Linux: set AIRFLOW_UID to the output of `id -u` so Airflow can write the
# bind-mounted logs/ and data/ folders. macOS: leave 50000.
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
POSTGRES_TRAIN_PORT=5432
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_JWT_SECRET=change-me-jwt-secret

# Locust (`loadtest` profile).
LOCUST_HOST=http://api-inference:8000
LOCUST_WORKERS=2
LOCUST_PORT=8089
LOCUST_ARGS=
